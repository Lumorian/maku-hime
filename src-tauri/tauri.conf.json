{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maku-hime",
  "version": "0.1.0",
  "identifier": "app.makuhime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "B 站弹幕姬",
    "longDescription": "maku-hime（幕姬）是一款轻量的 B 站直播弹幕姬：原生直连 B 站弹幕协议，支持可穿屏悬浮窗、OBS 浏览器源、扫码发弹幕、语音播报与历史导出。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {
      "../dist": "dist"
    }
  }
}
